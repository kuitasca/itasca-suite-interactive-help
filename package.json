{
  "name": "help-react",
  "version": "0.1.0",
  "homepage": ".",
  "private": true,
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "start:intellisense": "cross-env REACT_APP_ENTRY=intellisense react-scripts start",
    "build": "react-scripts build",
    "build:intellisense": "cross-env REACT_APP_ENTRY=intellisense BUILD_PATH=build-intellisense react-scripts build",
    "build:all": "npm run build && npm run build:intellisense",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "cross-env": "^10.1.0"
  }
}
